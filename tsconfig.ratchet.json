{
  // Typecheck config for scripts/typecheck-ratchet.mjs.
  //
  // Identical to tsconfig.json except that `.next/types/**` is excluded. Those
  // files are generated by `next build`, so whether they exist — and what they
  // contain — depends on whether someone has built recently. A gate that
  // changes its mind based on a stale build directory is not a gate. They
  // contribute zero errors today, so dropping them costs no coverage.
  "extends": "./tsconfig.json",
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}
